    "deps": "vpx taze -r -w -I",
    "typecheck": "vpr -r typecheck"
  },
  "devDependencies": {
    "@blankparticle/bp": "workspace:*",
    "@blankparticle/utils": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
