{
  "name": "@blankparticle/root",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "format": "vp fmt",
    "lint": "vp lint",
