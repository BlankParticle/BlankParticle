    "effect": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0"
    },
    "runtime": {
      "name": "node",
      "version": "^26.8.1"
